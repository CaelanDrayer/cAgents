{
  "name": "cagents",
  "version": "10.24.0",
  "description": "Universal multi-domain agent orchestration framework. 214 specialized agents across 8 business domains with 9 skills.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run --config tests/vitest.config.js",
    "test:hooks": "vitest run --config tests/vitest.config.js tests/hooks/",
    "test:config": "vitest run --config tests/vitest.config.js tests/config/",
    "test:watch": "vitest --config tests/vitest.config.js",
    "validate:configs": "python3 scripts/validate_agent_configs.py",
    "validate:agents": "bash scripts/ci/validate-agents.sh",
    "validate:versions": "bash scripts/ci/validate-versions.sh",
    "validate:counts": "bash scripts/validate-agent-counts.sh",
    "generate:manifest": "bash scripts/generate_plugin_manifest.sh",
    "lint": "npm run validate:configs",
    "ci": "npm run test && npm run validate:versions && npm run validate:agents"
  },
  "keywords": [
    "agents",
    "ai",
    "automation",
    "controller-centric",
    "question-based-delegation",
    "orchestration",
    "workflow",
    "multi-domain",
    "trigger",
    "designer",
    "optimizer",
    "reviewer",
    "agent-teams",
    "parallel-teams",
    "peer-to-peer",
    "shared-tasks",
    "team-execution",
    "super-domains",
    "game-development",
    "unity",
    "unreal-engine",
    "godot",
    "gameplay-programming",
    "level-design",
    "game-art",
    "game-audio",
    "game-production",
    "narrative-design",
    "game-dev-pipeline"
  ],
  "files": [
    "engineering/",
    "creative/",
    "business/",
    "growth/",
    "people/",
    "service/",
    "leadership/",
    "core/",
    "shared/",
    ".claude/",
    ".claude-plugin/",
    "scripts/",
    "CLAUDE.md",
    "README.md",
    "CONTRIBUTING.md",
    "GETTING_STARTED.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "author": "CaelanDrayer",
  "license": "MIT",
  "dependencies": {
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "ajv": "^8.18.0",
    "vitest": "^4.0.18"
  }
}
