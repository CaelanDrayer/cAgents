{
  "name": "cagents",
  "version": "10.12.0",
  "description": "213 agents across 8 business domains. Multi-agent orchestration with 8 commands for engineering, creative, business, and more.",
  "type": "module",
  "main": "",
  "scripts": {
    "test": "vitest run --config tests/vitest.config.js",
    "test:hooks": "vitest run --config tests/vitest.config.js tests/hooks/",
    "test:config": "vitest run --config tests/vitest.config.js tests/config/",
    "test:watch": "vitest --config tests/vitest.config.js",
    "validate:configs": "python3 scripts/validate_agent_configs.py",
    "validate:agents": "bash scripts/ci/validate-agents.sh",
    "validate:versions": "bash scripts/ci/validate-versions.sh",
    "validate:counts": "bash scripts/validate-agent-counts.sh",
    "generate:manifest": "bash scripts/generate_plugin_manifest.sh",
    "lint": "npm run validate:configs",
    "ci": "npm run test && npm run validate:versions && npm run validate:agents"
  },
  "keywords": [
    "agents",
    "ai",
    "automation",
    "controller-centric",
    "question-based-delegation",
    "orchestration",
    "workflow",
    "multi-domain",
    "trigger",
    "designer",
    "optimizer",
    "reviewer",
    "agent-teams",
    "parallel-teams",
    "peer-to-peer",
    "shared-tasks",
    "team-execution",
    "super-domains",
    "game-development",
    "unity",
    "unreal-engine",
    "godot",
    "gameplay-programming",
    "level-design",
    "game-art",
    "game-audio",
    "game-production",
    "narrative-design",
    "game-dev-pipeline"
  ],
  "author": "CaelanDrayer",
  "license": "MIT",
  "architecture": "Controller-Centric Question-Based Delegation",
  "agents": {
    "total": 213,
    "core": 15,
    "shared": 4,
    "breakdown": {
      "engineering": 33,
      "creative": 30,
      "business": 33,
      "growth": 36,
      "people": 19,
      "service": 33,
      "leadership": 10
    },
    "consolidation": "239 to 207 agents through v10.0.0 restructure",
    "domain_restructure": "5 super-domains to 8 business domains"
  },
  "business_domains": [
    "engineering",
    "creative",
    "business",
    "growth",
    "people",
    "service",
    "leadership",
    "shared"
  ],
  "features": {
    "controller_coordination": true,
    "question_based_delegation": true,
    "objective_driven_planning": true,
    "synthesis_driven_implementation": true,
    "parallel_execution": true,
    "max_concurrent_agents": 50,
    "trigger": true,
    "designer": true,
    "optimizer": true,
    "reviewer": true,
    "intelligent_agent_selection": true,
    "auto_fix_generation": true,
    "pattern_learning": true,
    "context_aware_detection": true,
    "pre_flight_validation": true,
    "bash_script_library": true,
    "lifecycle_hooks": true,
    "atomic_file_operations": true,
    "markdown_frontmatter_state": true,
    "ralph_loop_patterns": true,
    "agent_teams_integration": true,
    "team_mode": true,
    "parallel_team_execution": true,
    "peer_to_peer_messaging": true,
    "shared_task_lists": true,
    "game_development_pipeline": true,
    "game_engines_supported": [
      "Unity",
      "Unreal Engine",
      "Godot"
    ],
    "game_dev_specializations": [
      "design",
      "programming",
      "art",
      "audio",
      "production",
      "narrative",
      "qa",
      "monetization"
    ]
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  }
}
