{
  "$comment": "Full hooks configuration - cAgents V9.4 - requires Node.js for advanced features",
  "displayOrigin": "cAgents",
  "trustProjectMdFiles": true,
  "teammateMode": "tmux",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CAGENTS_VERSION": "9.4.1"
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Bash(git *)",
      "Write(Agent_Memory/**)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(sudo *)",
      "Write(/etc/**)",
      "Write(~/.ssh/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/scripts/hook-dispatch.sh hooks/session/on-session-start.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/scripts/hook-dispatch-node.sh .claude/hooks/session-catchup.cjs",
            "timeout": 5
          },
          {
            "type": "prompt",
            "prompt": "You are using cAgents V9.4. Follow the controller-centric delegation pattern. All requests minimum tier 2. Auto-proceed between phases without asking permission."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/scripts/hook-dispatch.sh hooks/session/on-session-end.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/scripts/hook-dispatch-node.sh .claude/hooks/team-stop.cjs",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/scripts/hook-dispatch.sh hooks/workflow/stop-workflow.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/scripts/hook-dispatch-node.sh .claude/hooks/verify-completion.cjs",
            "timeout": 10
          },
          {
            "type": "prompt",
            "prompt": "Before stopping, verify: all work items completed with evidence, coordination_log.yaml written, outputs produced."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/scripts/hook-dispatch.sh hooks/workflow/on-workflow-complete.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/scripts/hook-dispatch-node.sh .claude/hooks/subagent-tracker.cjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/scripts/hook-dispatch-node.sh .claude/hooks/team-start.cjs",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/scripts/hook-dispatch.sh hooks/workflow/on-user-prompt.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/scripts/hook-dispatch.sh hooks/tools/pre-bash.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/scripts/hook-dispatch.sh hooks/tools/pre-write.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/scripts/hook-dispatch-node.sh .claude/hooks/secret-detection.cjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/scripts/hook-dispatch.sh hooks/workflow/on-task-start.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/scripts/hook-dispatch.sh hooks/workflow/on-task-complete.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/scripts/hook-dispatch-node.sh .claude/hooks/tool-failure-tracker.cjs",
            "timeout": 5
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/scripts/hook-dispatch-node.sh .claude/hooks/teammate-idle-handler.cjs",
            "timeout": 5
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/scripts/hook-dispatch-node.sh .claude/hooks/team-task-complete.cjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/scripts/hook-dispatch-node.sh .claude/hooks/permission-handler.cjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/scripts/hook-dispatch-node.sh .claude/hooks/pre-compact-save.cjs",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/scripts/hook-dispatch-node.sh .claude/hooks/notification.cjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
