{
  "$comment": "Full hooks configuration - requires Node.js for advanced features",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'test -n \"$CLAUDE_PLUGIN_ROOT\" && \"$CLAUDE_PLUGIN_ROOT/hooks/session/on-session-start.sh\" || echo {\"continue\":true}'",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash -c 'test -n \"$CLAUDE_PLUGIN_ROOT\" && node \"$CLAUDE_PLUGIN_ROOT/.claude/hooks/session-catchup.cjs\" || echo {\"continue\":true}'",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'test -n \"$CLAUDE_PLUGIN_ROOT\" && \"$CLAUDE_PLUGIN_ROOT/hooks/session/on-session-end.sh\" || echo {\"continue\":true}'",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'test -n \"$CLAUDE_PLUGIN_ROOT\" && \"$CLAUDE_PLUGIN_ROOT/hooks/workflow/stop-workflow.sh\" || echo {\"continue\":true}'",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash -c 'test -n \"$CLAUDE_PLUGIN_ROOT\" && node \"$CLAUDE_PLUGIN_ROOT/.claude/hooks/verify-completion.cjs\" || echo {\"continue\":true}'",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'test -n \"$CLAUDE_PLUGIN_ROOT\" && \"$CLAUDE_PLUGIN_ROOT/hooks/workflow/on-workflow-complete.sh\" || echo {\"continue\":true}'",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'test -n \"$CLAUDE_PLUGIN_ROOT\" && \"$CLAUDE_PLUGIN_ROOT/hooks/workflow/on-user-prompt.sh\" || echo {\"continue\":true}'",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'test -n \"$CLAUDE_PLUGIN_ROOT\" && \"$CLAUDE_PLUGIN_ROOT/hooks/tools/pre-bash.sh\" || echo {\"continue\":true}'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'test -n \"$CLAUDE_PLUGIN_ROOT\" && \"$CLAUDE_PLUGIN_ROOT/hooks/tools/pre-write.sh\" || echo {\"continue\":true}'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash -c 'test -n \"$CLAUDE_PLUGIN_ROOT\" && node \"$CLAUDE_PLUGIN_ROOT/.claude/hooks/secret-detection.cjs\" || echo {\"continue\":true}'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'test -n \"$CLAUDE_PLUGIN_ROOT\" && \"$CLAUDE_PLUGIN_ROOT/hooks/workflow/on-task-start.sh\" || echo {\"continue\":true}'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'test -n \"$CLAUDE_PLUGIN_ROOT\" && \"$CLAUDE_PLUGIN_ROOT/hooks/workflow/on-task-complete.sh\" || echo {\"continue\":true}'",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'test -n \"$CLAUDE_PLUGIN_ROOT\" && node \"$CLAUDE_PLUGIN_ROOT/.claude/hooks/pre-compact-save.cjs\" || echo {\"continue\":true}'",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'test -n \"$CLAUDE_PLUGIN_ROOT\" && node \"$CLAUDE_PLUGIN_ROOT/.claude/hooks/notification.cjs\" || echo {\"continue\":true}'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
