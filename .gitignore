# Dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Environment
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.vscode/
.idea/
.obsidian/
*.swp
*.swo
*~
*.iml
.devcontainer/

# OS files
.DS_Store
Thumbs.db

# Build outputs
dist/
build/
*.tsbuildinfo

# Test outputs
test-results/
coverage/
playwright-report/
playwright/.cache/

# cAgents runtime memory - Exclude entire directory (runtime data, not part of source)
cagents-memory/
cagents-memory-staging/

# Archive - Documentation archive (not part of source control)
archive/

# Backup files
*.backup
backup_*/

# WI-2 (v12.12.1): belt-and-suspenders against broken-symlink re-creation.
# Claude Code's plugin discovery occasionally re-creates `.claude/skills/commit-changes`
# as a broken symlink when it encounters externally-bundled `commit-changes` skill
# references. The offending source symlink in _archive/ has been deleted, but
# this gitignore entry ensures any future session-time re-creation never makes
# it into a commit. See tests/skills/no-commit-changes-symlink.test.js for the
# regression guard.
.claude/skills/commit-changes

# Cache directories
.agent-cache/
.claude-plugin-cache/

# Domain-specific ignores
# Each domain plugin may have additional ignores

# Creative domain (future)
creative/outputs/drafts/

# Finance domain (future)
finance/outputs/reports/

documentation/temp/

# Local memory (personal preferences)
CLAUDE.local.md
*.local.md

# Claude Code sessions and plans (runtime data)
.claude/sessions/
.claude/plans/
.claude/*.lock

# Python virtual environment
.venv/
__pycache__/
example/
metrics.jsonl
vendor_repos/

# Test/tool temp directories
.loki-test-tmp/
.omc/
.orphaned_at
cagents-skills.zip
tests/.tmp/
