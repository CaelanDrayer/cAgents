{
  "$ref": "#/definitions/work-items",
  "definitions": {
    "work-items": {
      "type": "object",
      "properties": {
        "work_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "wave": {
                "type": "integer",
                "minimum": 0,
                "default": 1
              },
              "description": {
                "type": "string",
                "default": ""
              },
              "acceptance_criteria": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "assigned_to": {
                "type": "string"
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "in_progress",
                  "complete",
                  "failed"
                ]
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "work_items"
      ],
      "additionalProperties": true
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
